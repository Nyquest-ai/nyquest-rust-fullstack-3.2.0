# ──────────────────────────────────────────────────────────────────────────
# Nyquest engine — environment overrides for Docker / docker-compose
#
# Copy to .env (which is .gitignore'd) and tweak.  Nothing here is required;
# every var has a sane default in the image.  No secrets in this file by
# design — keep API keys out of the image AND out of source control.
# ──────────────────────────────────────────────────────────────────────────

# ── Bounded LRU compression cache ─────────────────────────────────────
# Read by src/compression/cache.rs::GLOBAL_CACHE on first access.

# Number of cached entries (default: 2048).  Set to 0 to disable entirely
# (or use NYQUEST_CACHE_ENABLED below).
NYQUEST_CACHE_CAPACITY=2048

# Skip caching anything bigger than this (bytes).  Default: 65536 (64 KB).
# Lower for memory-constrained hosts; raise if you cache giant tool results.
NYQUEST_CACHE_MAX_ENTRY_SIZE=65536

# Master switch.  Default: true.  Accepted values: 1 / true / yes / on
# (case-insensitive); anything else is treated as false.
NYQUEST_CACHE_ENABLED=true

# ── Logging ───────────────────────────────────────────────────────────────
# RUST_LOG is read by tracing-subscriber.  Examples:
#   info                  — default
#   debug                 — verbose
#   nyquest=trace,info    — trace nyquest, info for everything else
RUST_LOG=info

# ── Provider API keys (OPTIONAL) ──────────────────────────────────────────
# Only needed if you want the proxy itself to inject keys instead of
# requiring clients to send them.  Leave blank for client-supplied keys
# (the default and recommended pattern).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
